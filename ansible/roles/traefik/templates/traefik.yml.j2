api:
  dashboard: true
  insecure: true

entryPoints:
  web:
    address: ":{{ traefik_http_port }}"
  websecure:
    address: ":{{ traefik_https_port }}"
    # uploads to Quackpot (up to 8 MB) need longer than the default 60 s on slow connections
    transport:
      respondingTimeouts:
        readTimeout: 300s

providers:
  file:
    directory: /etc/traefik/conf.d
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ traefik_acme_email }}
      storage: /etc/traefik/acme.json
      httpChallenge:
        entryPoint: web

log:
  level: {{ traefik_log_level }}
