# Managed by Ansible (quackpot role)
QUACKPOT_HOSTNAME=0.0.0.0
QUACKPOT_PORT={{ quackpot_port }}
QUACKPOT_DB={{ quackpot_data_dir }}/quackpot.db
QUACKPOT_ADMIN_TOKEN={{ quackpot_admin_token }}
QUACKPOT_TRUSTED_PROXIES={{ quackpot_proxy_ip }}
QUACKPOT_OPEN_ROOMS={{ '1' if quackpot_open_rooms else '0' }}
QUACKPOT_CONFIG=/etc/quackpot/config.json
QUACKPOT_YT_DLP={{ quackpot_yt_dlp }}
QUACKPOT_FFMPEG={{ quackpot_ffmpeg }}
DENO_DIR={{ quackpot_data_dir }}/deno
